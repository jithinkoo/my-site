<Layouts.admin flash={@flash}>
  <h1>Your profile</h1>
  <p class="muted">This is how you appear across the site.</p>

  <.form for={@form} action={~p"/admin/profile"} method="put" multipart class="editor">
    <div class="field photo-field">
      <span class="label">Photo</span>
      <div class="photo-row">
        <img
          :if={@profile.photo_image_id}
          src={Portfolio.Media.path(@profile.photo_image_id)}
          alt="Your current photo"
          class="avatar avatar-sm"
        />
        <div :if={!@profile.photo_image_id} class="avatar avatar-sm avatar-empty" aria-hidden="true"></div>
        <div>
          <label for="profile_photo" class="sr-only">Upload a new photo</label>
          <input
            type="file"
            id="profile_photo"
            name="profile[photo]"
            accept="image/jpeg,image/png,image/webp"
            data-resize
          />
          <p class="hint" data-resize-note>
            Shown large on the left of every page, fading into the background. A tall photo works best.
          </p>
          <label :if={@profile.photo_image_id} class="check-inline">
            <input type="checkbox" name="profile[remove_photo]" value="true" /> Remove current photo
          </label>
        </div>
      </div>
    </div>

    <div class="field">
      <label for="profile_background_photos">Background photos (optional)</label>
      <input
        type="file"
        id="profile_background_photos"
        name="profile[background_photos][]"
        accept="image/jpeg,image/png,image/webp"
        multiple
        data-resize
      />
      <p class="hint" data-resize-note>
        Choose one or more photos (hold Ctrl to pick several). After your main photo, they fade one into the next in a loop.
      </p>
      <div :if={@background != []} class="bg-thumbs">
        <img :for={image <- @background} src={Portfolio.Media.path(image)} alt="" loading="lazy" />
        <a href={~p"/admin/images"} class="hint">Manage or remove on the Images page →</a>
      </div>
    </div>

    <.input
      field={@form[:photo_caption]}
      type="textarea"
      rows="3"
      label="Text on photo (optional)"
      hint="A short line shown over your photo. To sign it, put your name on a new line starting with a dash, e.g. -Jithin. Up to 200 characters."
      maxlength="200"
    />

    <.input field={@form[:name]} label="Name" required />
    <.input
      field={@form[:headline]}
      label="Headline"
      hint="One line under your name, e.g. Software engineer. Writer of small thoughts."
      required
    />
    <.input
      field={@form[:intro]}
      type="textarea"
      rows="3"
      label="Home page intro"
      hint="Two or three sentences on the home page. Markdown works."
    />
    <.input
      field={@form[:about]}
      type="textarea"
      rows="14"
      label="About page"
      hint="Your story, in your own words. Markdown works, including images from the Images page."
    />
    <.input field={@form[:location]} label="Location" />
    <.input field={@form[:email]} type="email" label="Public email (optional)" />
    <.input field={@form[:linkedin_url]} type="url" label="LinkedIn URL (optional)" placeholder="https://www.linkedin.com/in/..." />
    <.input field={@form[:github_url]} type="url" label="GitHub URL (optional)" placeholder="https://github.com/..." />
    <div class="actions">
      <button type="submit" class="button">Save profile</button>
    </div>
  </.form>
</Layouts.admin>
