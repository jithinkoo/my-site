<Layouts.admin flash={@flash}>
  <div class="admin-head">
    <h1>Edit post</h1>
    <a :if={@post.published} href={~p"/thoughts/#{@post.slug}"} target="_blank">View on site ↗</a>
  </div>
  <.post_form form={@form} action={~p"/admin/posts/#{@post}"} method="put" cover_id={@post.cover_image_id} />

  <details class="danger-zone">
    <summary>Delete this post</summary>
    <.form for={%{}} action={~p"/admin/posts/#{@post}"} method="delete">
      <p>This can't be undone.</p>
      <button type="submit" class="button button-danger">Delete permanently</button>
    </.form>
  </details>
</Layouts.admin>
