<Layouts.app flash={@flash} profile={@profile} slides={@slides}>
  <section class="hero">
    <p class="eyebrow reveal">{@profile.location}</p>
    <h1 class="reveal reveal-2">{@profile.name}</h1>
    <p class="lede reveal reveal-3">{@profile.headline}</p>
    <div :if={@profile.intro} class="intro prose reveal reveal-4">{markdown(@profile.intro)}</div>
    <p class="hero-links reveal reveal-5">
      <a href={~p"/about"} class="button">Read my story</a>
      <a href={~p"/thoughts"} class="button button-quiet">All thoughts →</a>
    </p>
  </section>

  <section class="playground reveal reveal-5" aria-labelledby="playground-title" data-playground>
    <div class="playground-head">
      <h2 id="playground-title" class="section-title-inline">Little things in motion</h2>
      <div class="play-tabs" role="tablist" aria-label="Watch or play">
        <button type="button" role="tab" class="play-tab is-active" aria-selected="true" data-mode="watch">
          Watch
        </button>
        <button type="button" role="tab" class="play-tab" aria-selected="false" data-mode="quiz">
          Quiz
        </button>
      </div>
    </div>
    <p class="hint playground-hint" data-hint-watch>
      <span class="hint-mouse">Move your mouse to push things around. Click to drop something new.</span>
      <span class="hint-touch">Drag to push things around. Tap to drop something new.</span>
    </p>

    <canvas class="physics" data-physics aria-hidden="true"></canvas>

    <div class="quiz" data-quiz hidden>
      <div class="quiz-top">
        <p class="quiz-high" data-quiz-high aria-live="polite">
          <%= if @quiz_high do %>
            🏆 High score <b>{@quiz_high.score}</b> by <b>{@quiz_high.name}</b>
          <% else %>
            🏆 No high score yet. Be the first!
          <% end %>
        </p>
        <div class="quiz-stats">
          <span class="quiz-score">
            Score <b data-quiz-score>0</b><span class="quiz-gain" data-quiz-gain aria-hidden="true"></span>
          </span>
          <span>⏱ <b data-quiz-time>0:00</b></span>
          <span class="quiz-streak" data-quiz-streak hidden>🔥 <span data-quiz-streak-n>3</span> in a row!</span>
        </div>
      </div>

      <div class="quiz-stage">
        <canvas class="quiz-mascot" data-quiz-mascot aria-hidden="true"></canvas>
        <div class="quiz-card" data-quiz-card aria-live="polite">
          <p class="quiz-q">
            {if @quiz_count > 0,
              do: "#{@quiz_count} quick questions, two choices each. Ready?",
              else: "Questions are on their way. Check back soon!"}
          </p>
          <button :if={@quiz_count > 0} type="button" class="button" data-quiz-start>Start</button>
        </div>
      </div>
    </div>

    <script defer src={~p"/assets/js/scene.js"}>
    </script>
    <script defer src={~p"/assets/js/quiz.js"}>
    </script>
  </section>

  <section class="section" aria-labelledby="latest">
    <h2 id="latest" class="section-title">Latest writing</h2>
    <p :if={@posts == []} class="muted">Nothing here yet. The first one is on its way.</p>
    <ul class="post-list">
      <li :for={post <- @posts}>
        <PortfolioWeb.PostHTML.post_item post={post} comments={Map.get(@comment_counts, post.id, 0)} />
      </li>
    </ul>
  </section>
</Layouts.app>
