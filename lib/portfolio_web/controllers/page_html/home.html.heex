<Layouts.app flash={@flash} profile={@profile}>
  <section class="hero">
    <p class="eyebrow reveal">{@profile.location}</p>
    <h1 class="reveal reveal-2">{@profile.name}</h1>
    <p class="lede reveal reveal-3">{@profile.headline}</p>
    <div :if={@profile.intro} class="intro prose reveal reveal-4">{markdown(@profile.intro)}</div>
    <p class="hero-links reveal reveal-5">
      <a href={~p"/about"} class="button">Read my story</a>
      <a href={~p"/thoughts"} class="button button-quiet">All thoughts →</a>
    </p>
  </section>

  <section class="playground reveal reveal-5" aria-labelledby="playground-title">
    <div class="playground-head">
      <h2 id="playground-title" class="section-title-inline">Little things in motion</h2>
      <p class="hint playground-hint">
        <span class="hint-mouse">Move your mouse to push the balls. Click to drop a new one.</span>
        <span class="hint-touch">Drag to push the balls. Tap to drop a new one.</span>
      </p>
    </div>
    <canvas class="physics" data-physics aria-hidden="true"></canvas>
  </section>

  <section class="section" aria-labelledby="latest">
    <h2 id="latest" class="section-title">Latest thoughts</h2>
    <p :if={@posts == []} class="muted">Nothing here yet. The first one is on its way.</p>
    <ul class="post-list">
      <li :for={post <- @posts}>
        <PortfolioWeb.PostHTML.post_item post={post} />
      </li>
    </ul>
  </section>
</Layouts.app>
